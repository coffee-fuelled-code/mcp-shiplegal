{
  "name": "mcp-shiplegal",
  "version": "1.0.0",
  "description": "MCP server for generating professional, jurisdiction-aware privacy policies. Supports GDPR, CCPA, Australian Privacy Act, and PIPEDA.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-shiplegal": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "privacy-policy",
    "terms-of-service",
    "legal",
    "gdpr",
    "ccpa",
    "compliance",
    "generator",
    "claude",
    "ai-tools"
  ],
  "author": "Uncommon Digital Group <support@uncommondigitalgroup.com> (https://uncommondigitalgroup.com)",
  "license": "MIT",
  "homepage": "https://shiplegal.uncommondigitalgroup.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffee-fuelled-code/mcp-shiplegal.git"
  },
  "bugs": {
    "url": "https://github.com/coffee-fuelled-code/mcp-shiplegal/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
